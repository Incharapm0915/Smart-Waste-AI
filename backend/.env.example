# ─── Smart Waste AI — Backend Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values

# App
APP_NAME=Smart Waste AI API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=production

# ─── Groq API (FREE) ──────────────────────────────────────────────────────────
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FAST_MODEL=llama-3.1-70b-8192

# ─── Firebase ─────────────────────────────────────────────────────────────────
# Download serviceAccountKey.json from Firebase Console → Project Settings → Service Accounts
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=smart-waste-ai-9ef1c

# ─── OCR ──────────────────────────────────────────────────────────────────────
# Linux (Docker): /usr/bin/tesseract
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# ─── Security ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=["https://your-flutter-app.com","http://localhost:3000"]

# Rate limiting
MAX_REQUESTS_PER_MINUTE=30
MAX_IMAGE_SIZE_MB=10
